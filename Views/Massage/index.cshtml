@model List<Project_sem2.Models.Massage>

<div>
	@foreach (var Massage in Model)
{
	<li>@Massage.Name | @Massage.Price</li>
	<a asp-controller="Massage" asp-action="EditMassage" asp-route-id ="@Massage.Id" class=" btn btn-primary">
	Edit </a>
	<form asp-controller="Massage" asp-action="DeleteMassage" method="post" >
		<input type="hidden" name="Id"  value="@Massage.Id" />
		<button type="submit" class="btn btn-danger">Delete</button>
	</form>

	
}
</div>

<div>
<a asp-controller ="Massage" asp-action="AddMassage" class=" btn btn-primary">
	Add a Massage

</a>

</div>
