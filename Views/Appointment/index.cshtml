@model List<Project_sem2.Models.Client>

<div>
	@foreach (var Client in Model)
{
	<li>@Client.Name | @Client.Email</li>
	<a asp-controller="Appointment" asp-action="EditClient" asp-route-id ="@Client.Id" class=" btn btn-primary">
	Edit </a>
	<form asp-controller="Appointment" asp-action="DeleteClient" method="post" >
		<input type="hidden" name="Id"  value="@Client.Id" />
		<button type="submit" class="btn btn-danger">Delete</button>
	</form>

	
}
</div>

<div>
<a asp-controller ="Appointment" asp-action="AddClient" class=" btn btn-primary">
	Add a Client

</a>

</div>
